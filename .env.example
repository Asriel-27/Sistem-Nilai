# ---- Port ----
GATEWAY_PORT=3000
NILAI_PORT=3001
TRANSKRIP_PORT=3002

# ---- URL service (dipakai gateway untuk proxy & Service Nilai untuk memanggil via gateway) ----
NILAI_URL=http://localhost:3001
TRANSKRIP_URL=http://localhost:3002
GATEWAY_URL=http://localhost:3000

# ---- Rahasia (ganti di lingkungan nyata!) ----
JWT_SECRET=ganti-dengan-string-acak-panjang
GATEWAY_SECRET=ganti-dengan-gateway-secret-acak

# ---- Kredensial Service Nilai untuk POST /auth/service ----
SERVICE_CLIENT_ID=service-nilai
SERVICE_CLIENT_SECRET=svc-nilai-secret-dev

# ---- Masa berlaku token ----
ACCESS_TOKEN_TTL=10m
REFRESH_TOKEN_TTL_HOURS=24
SERVICE_TOKEN_TTL=5m

# ---- Jam akses (bisa diubah agar mudah didemokan) ----
ACCESS_HOUR_START=7
ACCESS_HOUR_END=21
ACCESS_TZ=Asia/Jakarta

# ---- Database ----
DB_PATH=./data/sistem-nilai.db

# ---- UI demo (opsional) ----
DEMO_UI_PORT=3003
DEMO_UI_ORIGIN=http://localhost:3003,http://127.0.0.1:3003
